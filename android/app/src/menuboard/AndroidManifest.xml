<?xml version="1.0" encoding="utf-8"?>
<!-- menuboard flavor overlay (merged onto src/main). Makes the app a valid Fire TV /
     Android-TV app: no touchscreen required, leanback-capable, and it appears on the
     TV launcher with a banner. Purely additive so the POS build is unaffected. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TVs have no touchscreen; declaring these not-required lets the app install on a Fire TV. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>

    <application android:banner="@mipmap/ic_launcher">
        <!-- Adds the TV-home (leanback) launcher entry to the existing MainActivity. -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
