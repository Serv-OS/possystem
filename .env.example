# Copy this file to .env.local and fill in your Supabase project details
# Get these from: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: set to 'true' to use mock data instead of Supabase (for local dev without a project)
VITE_USE_MOCK=false

# Environment tier: 'dev' | 'stage' | 'prod'
# Controls customer-facing URLs, visual indicators, and safety guards.
VITE_APP_TIER=dev

# Base domain for customer-facing subdomains.
# Customer URLs become: <slug>.<tier>.serv-os.app (dev/stage) or <slug>.serv-os.app (prod)
VITE_CUSTOMER_DOMAIN=serv-os.app
