# ─── Restaurant OS Print Agent Config ────────────────────────────────────────
# Copy this file to: print-agent.env
# Then fill in SUPABASE_KEY and PRINT_AGENT_TOKEN and run: node print-agent.js

# Supabase project URL (already set for this project)
SUPABASE_URL=https://tbetcegmszzotrwdtqhi.supabase.co

# Supabase anon/public key
# Get it from: https://supabase.com/dashboard/project/tbetcegmszzotrwdtqhi/settings/api
# It's labelled "anon public" — starts with eyJ, about 200 chars long
SUPABASE_KEY=

# Print agent key for this venue (database fence stage 1).
# Back Office, Production printing, "Print agent key": the key is shown ONCE, paste it here.
# With it the agent claims jobs through print_agent_claim / print_agent_report, the only way
# to reach print jobs once the fence is complete. Revoke it in the same place.
PRINT_AGENT_TOKEN=

# Location ID: now only used for log lines and the printer status rows (the key decides the
# venue). Without a key it also limits the old direct mode to this venue.
LOCATION_ID=
