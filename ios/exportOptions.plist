<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CLI archive + upload, once Xcode is installed:
	     xcodebuild -project "ServOS POS.xcodeproj" -scheme "ServOS POS" \
	       -destination "generic/platform=iOS" archive -archivePath build/ServOSPOS.xcarchive
	     xcodebuild -exportArchive -archivePath build/ServOSPOS.xcarchive \
	       -exportOptionsPlist exportOptions.plist -exportPath build/export
	     For unattended CLI use, add the keys:
	       teamID (10 char Apple Developer team id)
	     and pass App Store Connect API auth to xcodebuild:
	       -authenticationKeyPath / -authenticationKeyID / -authenticationKeyIssuerID -->
	<key>teamID</key>
	<string>LYQ8K25MGZ</string>
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>destination</key>
	<string>upload</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Build numbers are managed here (version discipline), not by Apple. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
